
KS--BR--Home QLabel
{
    font-size: 14px;
}

KS--BR--Home QLabel#m_heading
{
    font-size: 24px;
}

KS--BR--Home QComboBox#m_scanComboBox
{
    background-color: transparent;
    border: 0px;
    color:#00a2ff;
    font-size: 14px;
}
KS--BR--Home QComboBox#m_scanComboBox::down-arrow
{
    background-color: transparent;
    border: 0px;
    image:url(:/images/combobox-arrow);
}
KS--BR--Home QComboBox#m_scanComboBox::drop-down
{
    background-color: transparent;
    border: 0px;
}

KS--BR--Home QComboBox#m_scanComboBox QAbstractItemView
{
    background-color: #393939;
    border: 0px;
    color:white;
}

KS--BR--Progress QPushButton#m_generateReport
{
    background-color: transparent;
    border: 0px;
    color: #00a2ff;
}
KS--BR--Progress QPushButton#m_generateReport:hover
{
    color: #43A3F2;
}

KS--BR--Progress QProgressBar#m_progressBar
{
    border: none;
    background: #393939;
}

KS--BR--Progress QProgressBar#m_progressBar:chunk
{
    background-color: #00a2ff;
    width: 1px;
}

KS--BR--Scan QHeaderView::section
{
    background-color: #393939;
    border: none;
    margin-bottom: 0px;
    padding-left: 16px;
}

KS--BR--Scan QHeaderView::section:first
{
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    padding-left: 36px;
}

KS--BR--Scan QTreeView
{
    show-decoration-selected: 1;
    background-color: transparent;
    selection-background-color: #43A3F2;
    font-size: 12px;
    color: white;

    border: none;
    border-radius: 4px;
}

KS--BR--Scan QTreeView > QWidget
{
    margin: 0px 10px 0px 0px;
}

/* 有子项的item */
KS--BR--Scan QTreeView::item:has-children
{
    margin: 4px 0px 0px 0px;
    background-color: #393939;
    border: none;
    padding-left:14px;
}

/* 有子项的第一列 */
KS--BR--Scan QTreeView::item:first:has-children
{
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

/* 有子项的第一列展开 */
KS--BR--Scan QTreeView::item:open:first:has-children
{
    border-top-left-radius: 4px;
    border-bottom-left-radius: 0px;
}

/* 有子项的最后一列 */
KS--BR--Scan QTreeView::item:last:has-children
{
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-left:70px;
}
/* 有子项的最后一列展开 */
KS--BR--Scan QTreeView::item:open:last:has-children
{
    border-top-right-radius: 4px;
    border-bottom-right-radius: 0px;
}

/* 没有子项的item */
KS--BR--Scan QTreeView::item:!has-children
{
    margin: 0px 0px 0px 0px;
    background-color: #393939;
    border: none;
    padding-left:14px;
}

KS--BR--Scan QTreeView::branch
{
    border: 0px;
    background-color: #393939;
    padding-left:14px;
    margin: 0px 0px 0px 0px;
}

/* 展开后branch最后一项左侧的空白缩进item */
KS--BR--Scan QTreeView::branch:!has-siblings:adjoins-item
{
    border-bottom-left-radius: 4px;
}
/* 展开后items最后一列item */
KS--BR--Scan QTreeView::item:!has-siblings:last
{
    border-bottom-right-radius: 4px;
}

/*
KS--BR--Scan QTreeView::branch:!has-children:!has-siblings:adjoins-item,
KS--BR--Scan QTreeView::branch:has-siblings:adjoins-item
{
    background: red;
    margin: 0px 0px 0px 0px;
}
*/

KS--BR--Scan QTreeView::item:has-children:hover,
KS--BR--Scan QTreeView::item:!has-children:hover,
KS--BR--Scan QTreeView::item:has-children:selected,
KS--BR--Scan QTreeView::item:!has-children:selected,
KS--BR--Scan QTreeView::branch:has-children:hover,
KS--BR--Scan QTreeView::branch:!has-children:hover,
KS--BR--Scan QTreeView::branch:has-children:selected,
KS--BR--Scan QTreeView::branch:!has-children:selected
{
    background-color: #43A3F2;
}

KS--BR--Scan QTreeView::indicator:enabled:unchecked
{
    image: url(:/images/checkbox-unchecked-normal);
}

KS--BR--Scan QTreeView::indicator:enabled:checked
{
    image: url(:/images/checkbox-checked-normal);
}

KS--BR--Scan QTreeView::indicator:enabled:indeterminate
{
    image: url(:/images/checkbox-indeterminate-normal);
}

/*
KS--BR--Scan QTreeView::indicator::disabled:checked{
    image: url(:/images/checkbox-checked-disabled);
}

KS--BR--Scan QTreeView::indicator::disabled:unchecked{
    image: url(:/images/checkbox-unchecked-disabled);
}

KS--BR--Scan QTreeView::indicator::disabled:indeterminate{
    image: url(:/images/checkbox-indeterminate-normal);
}
*/

KS--BR--ReinforcementArgsDialog QListWidget
{
    background-color: transparent;
}

KS--BR--ArgHandle QComboBox,
KS--BR--ArgHandle QLineEdit
{
    height: 36px;
    background-color: #222222;
    border: 1px solid #454545;
    border-radius: 6px;
    padding-left:12px;
    padding-right:12px;
    combobox-popup:0;
    font-size: 12px;
    color: white;

}

KS--BR--ArgHandle QComboBox QAbstractItemView
{
    background-color:#222222;
    color: white;
    border-radius: 6px;
    border-bottom: 1px solid #454545;
    border-right: 1px solid #454545;
    border-left: 1px solid #454545;
    /*设置下拉框item背景颜色，不设置的话在index=-1时，第一行会有qt自带的渐变色，不符合ui设计*/
    selection-background-color: #222222;
}

KS--BR--ArgHandle QComboBox QAbstractItemView::item
{
    height: 36px;
    border-top: 1px solid #454545;
    padding-left:10px;
}

KS--BR--ArgHandle QComboBox QAbstractItemView::item:hover,
KS--BR--ArgHandle QComboBox QAbstractItemView::item:selected
{
    background-color:#00a2ff;
    color: white;
}

KS--BR--ArgHandle QComboBox::drop-down
{
    border:none;
    padding-right:12px;
}

KS--BR--ArgHandle QComboBox::down-arrow
{
      image: url(:/images/arrow-down);
}

KS--BR--ArgHandle QSpinBox
{
    height: 36px;
    background-color: #222222;
    border: 1px solid #454545;
    border-radius: 6px;
    padding-left:12px;
    padding-right:12px;
    combobox-popup:0;
    font-size: 12px;
    color: white;
}

KS--BR--ArgHandle QSpinBox::up-button,
KS--BR--ArgHandle QSpinBox::down-button
{
    width : 0px;
    height : 0px;
    border : 0px;
}

KS--BR--ArgHandle QPushButton#noteIcon
{
    background-color: transparent;
}
