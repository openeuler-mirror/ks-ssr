*{
    color:white;
    font-size:13px;
}

KS--Window
{
    border-radius: 4px;
    background-color:#2d2d2d;
}

QPushButton:checked
{
    background-color: #00a2ff;
}

QPushButton
{
    border-radius:4px;
    background:#393939;
    border: none;
}

QPushButton:hover
{
    background:#464646;
}

QPushButton[okStyle="true"]
{
    background:#43A3F2;
}

QPushButton[okStyle="true"]:hover
{
    background:#79C3FF;
}

QLineEdit
{
    background-color: #222222;
    border: 1px solid #454545;
    border-radius: 6px;
    color: white;
}

QToolTip
{
    background-color: white;
    border-radius: 4px;
    color: #000000;
}


/* common scrollarea/scrollbar */

QScrollArea
{
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    margin: 0px;
    width: 4px;
}

QScrollBar::handle:vertical {
    border: none;
    border-radius: 2px;
    background-color: #595959;
    min-width: 4px;
    min-height:30px;
    margin: 0px;
}

QScrollBar::handle:vertical:hover {
    background-color: #696969;
}

QScrollBar::handle:vertical:pressed  {
    background-color: #2eb3ff;
}

QScrollBar::add-line:vertical {
    border: none;
    background: none;
}

QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

/* common table */
QHeaderView,
QTableView
{
    background-color: transparent;
}

QHeaderView#tableHeaderProxy
{
    color: #919191;
}

KS--HeaderButtonDelegate QLabel
{
    color: #919191;
}

KS--HeaderButtonDelegate
{
    background-color: transparent;
}
KS--HeaderButtonDelegate::menu-indicator
{
    image: none;
}

/* SideBar */
KS--SideBar
{
    background-color:#2d2d2d;
    border-radius: 6px;
    padding-left: 10px;
    padding-top: 16px;
    padding-right: 24px;
}
KS--SideBar::item
{
    border: 0px;
    background-color: #393939;
    margin: 2px 0px 2px 0px;
    border-radius: 6px;
    border: 6px
}

KS--SideBar::item::selected
{
    background: #00a2ff;
}

QHeaderView::section
{
    background-color: #393939;
    border: none;
    margin-bottom: 2px;
    padding-left:10px;
}

KS--DM--DeviceLogPage QHeaderView::section:first,
KS--DM--DeviceListPage QHeaderView::section:first
{
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

KS--TP--KernelProtectedPage QHeaderView::section:first,
KS--TP--ExecuteProtectedPage QHeaderView::section:first,
KS--FP--FileProtectionPage QHeaderView::section:first,
KS--ToolBox--FileShredPage QHeaderView::section:first,
KS--ToolBox--FileSign QHeaderView::section:first,
KS--ToolBox--PrivacyCleanupPage QHeaderView::section:first,
KS--QHeaderView::section:first
{
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    padding-left:-2px;
}

QHeaderView::section:last
{
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QTableView::item
{
    border: none;
    /*background-color: #393939;*/
    background-color: transparent;
    margin: 2px 0px 2px 0px;
    padding-left:10px;
}

/* common QCheckBox */

QCheckBox::indicator:unchecked {
    image: url(:/images/checkbox-unchecked-normal);
}

QCheckBox::indicator:unchecked:hover {
    image: url(:/images/checkbox-unchecked-hover);
}

QCheckBox::indicator:unchecked:pressed {
    image: url(:/images/checkbox-unchecked-active);
}

QCheckBox::indicator:checked {
    image: url(:/images/checkbox-checked-normal);
}

QCheckBox::indicator:checked:hover {
    image: url(:/images/checkbox-checked-hover);
}

QCheckBox::indicator:checked:pressed {
    image: url(:/images/checkbox-checked-active);
}

QCheckBox::indicator:indeterminate{
    image: url(:/images/checkbox-indeterminate-normal);
}

QCheckBox::indicator:indeterminate:hover {
    image: url(:/images/checkbox-indeterminate-hover);
}

QCheckBox::indicator:indeterminate:pressed {
    image: url(:/images/checkbox-indeterminate-active);
}
QCheckBox::indicator::disabled:checked{
    image: url(:/images/checkbox-checked-disabled);
}
QCheckBox::indicator::disabled:unchecked{
    image: url(:/images/checkbox-unchecked-disabled);
}

/* common menu */
QMenu
{
    background-color:#2d2d2d;
    border-radius: 6px;
    top:10px;
}

QMenu QAbstractItemView
{
    border-radius: 6px;
}

QMenu::item
{
    border-radius: 6px;
    height: 30px;
    width:100px;
    margin:0px;
    padding-left:24px;
}
QMenu::item:hover
{
    background-color:#393939;
}

QMenu::item:selected
{
    background-color:#393939;
}

/* main window */
QWidget#m_banner
{
    background-image: url(":/images/banner");
    border-radius: 6px
}

KS--NavigationItem QPushButton#m_icon
{
    padding: 8px;
    border-radius: 6px;
}

KS--Window QWidget#m_contents
{
    background-color: #222222;
    border-radius: 6px;
}

QWidget#m_deleteNotify,
QFrame#m_frame,
KS--Loading#maskWidget
{
    background-color: #2d2d2d;
    border-radius: 6px;
}

KS--Window QPushButton#btnForMenu,
KS--Window QPushButton#accountButton,
KS--Window QStackedWidget#m_stackedPages
{
    background:#2d2d2d;
    border-radius: 6px;
}
KS--Window QPushButton#btnForMenu::menu-indicator
{
    image: url(:/images/more);
    subcontrol-position: center center;
    subcontrol-origin: padding;
}
KS--Window QPushButton#accountButton::menu-indicator
{
    image: url(:/images/user-manager);
    subcontrol-position: center center;
    subcontrol-origin: padding;
}

QPushButton#activateStatus
{
    background:rgba(255, 61, 61,255);
    font-family: Noto Sans CJK SC regular;
    border-radius: 6px;
}

KS--Loading QLabel#loadingLabel
{
    color:#919191;
}

KS--Window QPushButton#btnForMenu
{
    background:#2d2d2d;
}

/* Settings */
KS--Settings QListWidget
{
    background-color:#2d2d2d;
    border-radius: 6px;
    padding-left: 10px;
    padding-top: 16px;
    padding-right: 24px;
}
KS--Settings QListWidget::item
{
    border: 0px;
    background-color: #393939;
    margin: 2px 0px 2px 0px;
    border-radius: 6px;
    border: 6px
}
KS--Settings QListWidget::item:selected
{
    background-color: #00a2ff;
}

QLabel#m_license
{
    color:#919191;

    font-size:10px;
}

/* message dialog */
QWidget#messageDialog
{
    background-color: #2d2d2d;
    border-radius: 6px;
}

KS--MessageDialog QTextBrowser
{
    background-color: transparent;
    color:white;
}


/* security box */
QMenu#m_popupMenu
{
    color:black;
}

/* Tool Box */
KS--ToolBox--FileShredPage QTableView#m_table > QWidget,
KS--ToolBox--PrivacyCleanupPage QTableView#m_table > QWidget,
QTableView#m_fileSignTable > QWidget
{
    margin: 0px 22px 0px 0px;
}

KS--ToolBox--AccessControlPage QTableView#m_table > QWidget
{
    margin: 0px 0px 0px 0px;
}

KS--ToolBox--AccessControlPage QHeaderView::section:first
{
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}
KS--ToolBox--AccessControlPage QWidget#m_controlLine
{
    border-radius: 4px;
    background-color: #393939;
}

/* file protected */
QTableView#m_fileTable > QWidget
{
    margin: 0px 22px 0px 0px;
}
QLabel#m_tips
{
    color:#919191;
}

/* trusted protected */
QTableView#m_executeTable > QWidget,
QTableView#m_kernelTable > QWidget
{
    margin: 0px 18px 0px 0px;
}

QPushButton#searchButton
{
    background-color: transparent;
}

QPushButton#m_switch
{
    image: url(:/images/switch-close);
    background-color: transparent;
}

QPushButton#m_switch:checked
{
    image: url(:/images/switch-open);
}

QPushButton#m_soft,
QPushButton#m_hard
{
    image: url(:/images/radio-unchecked);
    background-color: transparent;
}

QPushButton#m_soft:checked,
QPushButton#m_hard:checked
{
    image: url(:/images/radio-checked);
}

QToolButton#m_refresh
{
    border:none;
    background-color: transparent;
}

QStackedWidget#m_stacked
{
    background-color:#2d2d2d;
    border-radius: 6px;
    color: white;
}


/* Device */
KS--DM--DeviceListPage QLineEdit QPushButton,
KS--DM--DeviceLogPage QLineEdit QPushButton
{
    background-color:transparent;
}

KS--DM--DeviceListPage QLabel#m_records,
KS--DM--DeviceLogPage QLabel#m_records
{
    color:#919191;
}

KS--DM--DevicePermission  QComboBox
{
    background-color: #222222;
    border: 1px solid #454545;
    border-radius: 6px;
    padding-left:12px;
    padding-right:12px;
    combobox-popup:0;
}

KS--DM--DevicePermission QComboBox QAbstractItemView {
    background-color:#222222;
    border-radius: 6px;
    border-bottom: 1px solid #454545;
    border-right: 1px solid #454545;
    border-left: 1px solid #454545;
    /*设置下拉框item背景颜色，不设置的话在index=-1时，第一行会有qt自带的渐变色，不符合ui设计*/
    selection-background-color: #222222;
}

KS--DM--DevicePermission QComboBox QAbstractItemView::item
{
    min-height: 36px;
    border-top: 1px solid #454545;
    padding-left:12px;
}

KS--DM--DevicePermission QComboBox QAbstractItemView::item:selected
{
    background-color:#00a2ff;
}

KS--DM--DevicePermission QComboBox::drop-down
{
    border:none;
    padding-right:12px;
}

KS--DM--DevicePermission QComboBox::down-arrow {
      image: url(:/images/arrow-down);
}

KS--DM--DevicePermission #m_groupBox
{
    border:none;
}

KS--DM--DevicePermission #m_groupBox QCheckBox
{
   background-color:#393939;
   border: none;
   border-radius: 6px;
   padding-left:12px;
}

KS--DM--DevicePermission #m_groupBox QCheckBox:disabled
{
   color:#919191;
}

KS--DM--DevicePermission QPushButton#m_confirm:disabled
{
    color:#919191;
    background-color:#393939;
}

KS--DM--DevicePermission QComboBox QLineEdit#lineEdit
{
    background-color:#222222;
}

KS--DM--DevicePermission QWidget#m_content
{
    border-radius: 6px;
    background-color:#2d2d2d;
}


KS--DM--DMSettingPage QCheckBox::indicator:unchecked,
KS--ToolBox--AuthenticationSettingPage QCheckBox::indicator:unchecked,
KS--ToolBox--AccessControlPage QCheckBox::indicator:unchecked
{
    image: url(:/images/switch-close);
}

KS--DM--DMSettingPage QCheckBox::indicator:unchecked:hover,
KS--ToolBox--AuthenticationSettingPage QCheckBox::indicator:unchecked:hover,
KS--ToolBox--AccessControlPage QCheckBox::indicator:unchecked:hover
{
    image: url(:/images/switch-close);
}

KS--DM--DMSettingPage QCheckBox::indicator:unchecked:pressed,
KS--ToolBox--AuthenticationSettingPage QCheckBox::indicator:unchecked:pressed,
KS--ToolBox--AccessControlPage QCheckBox::indicator:unchecked:pressed
{
    image: url(:/images/switch-close);
}

KS--DM--DMSettingPage QCheckBox::indicator:checked,
KS--ToolBox--AuthenticationSettingPage QCheckBox::indicator:checked,
KS--ToolBox--AccessControlPage QCheckBox::indicator:checked
{
    image: url(:/images/switch-open);
}

KS--DM--DMSettingPage QCheckBox::indicator:checked:hover,
KS--ToolBox--AuthenticationSettingPage QCheckBox::indicator:checked:hover,
KS--ToolBox--AccessControlPage QCheckBox::indicator:checked:hover
{
    image: url(:/images/switch-open);
}

KS--DM--DMSettingPage QCheckBox::indicator:checked:pressed,
KS--ToolBox--AuthenticationSettingPage QCheckBox::indicator:checked:pressed,
KS--ToolBox--AccessControlPage QCheckBox::indicator:checked:pressed
{
    image: url(:/images/switch-open);
}

KS--DM--DMSettingPage #customWidget
{
    border-radius: 6px;
    background-color:#2d2d2d;
}

KS--User QComboBox,
KS--User QLineEdit
{
    height: 36px;
    background-color: #222222;
    border: 1px solid #454545;
    border-radius: 6px;
    padding-left:12px;
    padding-right:12px;
    combobox-popup:0;
}

KS--User QComboBox QAbstractItemView
{
    background-color:#222222;
    color: white;
    border-radius: 6px;
    border-bottom: 1px solid #454545;
    border-right: 1px solid #454545;
    border-left: 1px solid #454545;
    /*设置下拉框item背景颜色，不设置的话在index=-1时，第一行会有qt自带的渐变色，不符合ui设计*/
    selection-background-color: #222222;
}

KS--User QComboBox QAbstractItemView::item
{
    height: 36px;
    border-top: 1px solid #454545;
    padding-left:10px;
}


KS--User QComboBox QAbstractItemView::item:hover,
KS--User QComboBox QAbstractItemView::item:selected
{
    background-color:#00a2ff;
    color: white;
}

KS--User QComboBox::drop-down
{
    border:none;
    padding-right:12px;
}

KS--User QComboBox::down-arrow
{
      image: url(:/images/arrow-down);
}




/*********License*****************/
QWidget#m_content
{
    border-radius: 6px;
    background-color:#2d2d2d;
}

/******  log audit  ******/
KS--DatePickButton
{
    background-color: #222222;
    border: 1px solid #454545;
    border-radius: 6px;
}

KS--DatePickButton QWidget
{
    background-color: #222222;
}

KS--CalendarWidget QWidget
{
    background-color: #2d2d2d;
}
KS--DatePicker
{
    background: #222222;
    border-radius: 6px;
}

KS--Pagination QPushButton
{
    background-color: #393939;
    outline: none;
    border:0px;
    border-radius: 4px;
}

KS--Pagination QPushButton:checked
{
    background-color: #2eb3ff;
}
KS--Pagination QPushButton:hover
{
    background-color: #464646;
}

KS--Log--LogPage QTableView#m_logTable > QWidget
{
    margin: 0px 22px 0px 0px;
}

KS--Log--LogPage QHeaderView::section:first
{
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

/******  password note  ******/
QPushButton#m_confirmPasswordNote,
QPushButton#m_newPasswordNote,
QPushButton#m_passwordNote
{
    image: url(:/images/note);
    background-color: transparent;
}

KS--Remote--RemotePage QWidget#widget_reinforce,QWidget#widget_repair
{
    background-color: #393939;
    border-radius: 6px;
}

QProgressBar
{
    border: none;
    background: #393939;
}

QProgressBar:chunk
{
    background-color: #00a2ff;
    width: 1px;
}
